% Bibliography. Cite entries in the .qmd files with [@key], e.g. [@example2024].
% Two at once: [@a2024; @b2023]. Rendered as compact superscript numerals by
% nature.csl — change the csl: line in _quarto.yml for a different style.
%
% Only cite keys that exist here. A missing key renders as a broken "?" in the
% PDF, and it is easy to miss. Never invent a DOI: omit the field instead.

@article{example2024,
  author  = {Doe, Jane and Roe, Richard},
  title   = {An example entry — replace this with your own},
  journal = {Nature},
  year    = {2024},
  volume  = {600},
  pages   = {123--130},
  doi     = {10.1038/s41586-024-00000-0}
}
